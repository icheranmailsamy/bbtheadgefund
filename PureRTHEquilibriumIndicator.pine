//@version=6
indicator("Pure RTH 50% Equilibrium Engine [Morning Sniper]", shorttitle="50% Equilibrium", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ==============================================================================
// 1. USER INPUTS & STYLING CONTROLS
// ==============================================================================
grp_strat   = "Strategy Parameters"
min_range   = input.float(8.0, "Minimum Setup Range (Points)", minval=1.0, step=0.5, group=grp_strat, tooltip="Minimum distance between wave anchor and extreme (Canonical: 8.0 pts = 32 ticks)")
session_mode= input.string("Morning Sniper (09:30 - 11:30)", "Session Window", options=["Morning Sniper (09:30 - 11:30)", "Full Day RTH (09:30 - 16:00)"], group=grp_strat)

grp_vis     = "Visual Elements & Styling"
show_arrow  = input.bool(true, "Show Entry Arrows & Labels", group=grp_vis)
show_exits  = input.bool(true, "Show Exit Badges (TP / SL / Flat)", group=grp_vis)
show_lines  = input.bool(true, "Show Active TP & SL Bracket Lines", group=grp_vis)
show_tint   = input.bool(true, "Highlight Active Session Window", group=grp_vis)
show_hud    = input.bool(true, "Show Live Status HUD Dashboard", group=grp_vis)

// Modern Minimalist Institutional Palette
color col_bull = #00E676      // Emerald Green
color col_bear = #FF5252      // Crimson Red
color col_tp   = #00E676      // Take Profit Green
color col_sl   = #FF5252      // Stop Loss Red
color col_flat = #9E9E9E      // Slate Gray
color col_tint = color.new(#2962FF, 95) // Subtle killzone blue background tint

// ==============================================================================
// 2. NEW YORK TIMEZONE & SESSION LOGIC
// ==============================================================================
int t_hour      = hour(time, "America/New_York")
int t_min       = minute(time, "America/New_York")
int t_total_min = t_hour * 60 + t_min
int end_min     = (session_mode == "Morning Sniper (09:30 - 11:30)") ? 690 : 960

bool is_rth_open      = (t_hour == 9 and t_min == 30)
bool is_window        = (t_total_min >= 570 and t_total_min < end_min)
bool is_session_close = (t_total_min >= end_min)

// Session tinting
bgcolor(show_tint and is_window ? col_tint : na, title="Trading Session Window")

// ==============================================================================
// 3. PERSISTENT STATE MACHINE VARIABLES (ZERO-REPAINT ARCHITECTURE)
// ==============================================================================
var float day_high          = 0.0
var float day_low           = 1e9

var int   bull_state        = 0
var float bull_anchor       = 0.0
var float bull_extreme      = 0.0
var float bull_lowest_w1    = 0.0
var float bull_retrace_low  = 0.0
var float bull_stoprun_low  = 0.0
var int   bull_anchor_bar   = 0
var int   bull_extreme_bar  = 0
var int   bull_lowest_w1_bar = 0
var bool  bull_wave_traded  = false
var int   bull_wave_count   = 1

var int   bear_state        = 0
var float bear_anchor       = 0.0
var float bear_extreme      = 0.0
var float bear_highest_w1   = 0.0
var float bear_retrace_high = 0.0
var float bear_stoprun_high = 0.0
var int   bear_anchor_bar   = 0
var int   bear_extreme_bar  = 0
var int   bear_highest_w1_bar = 0
var bool  bear_wave_traded  = false
var int   bear_wave_count   = 1
var int   current_trade_wave = 0

var string active_bias      = "NONE"

// Open Trade Tracking
var int   pos               = 0    // +1 = Long, -1 = Short, 0 = Flat
var float entry_price       = 0.0
var float sl_price          = 0.0
var float tp_price          = 0.0
var float lowest_in_trade   = 0.0
var float highest_in_trade  = 0.0
var int   entry_bar_idx     = 0
var int   last_exit_bar_idx = -1

// Line tracking references
var line  active_tp_line    = na
var line  active_sl_line    = na

// Daily performance tracking for HUD
var int   today_trades      = 0
var int   today_wins        = 0
var int   today_losses      = 0
var float today_pts         = 0.0

// ==============================================================================
// 4. HARD FLATTEN AT SESSION CUTOFF
// ==============================================================================
if is_session_close and pos != 0
    float pts_made = (pos == 1) ? (close - entry_price) : (entry_price - close)
    today_trades += 1
    today_pts    += pts_made
    if pts_made > 0
        today_wins += 1
    else
        today_losses += 1

    if show_exits
        string txt = "⏱ Flat Close\n" + (pts_made >= 0 ? "+" : "") + str.tostring(pts_made, "#.##") + " pts"
        label.new(bar_index, (pos == 1 ? high : low), text=txt, color=col_flat, textcolor=color.white, style=(pos == 1 ? label.style_label_down : label.style_label_up), size=size.small)

    if not na(active_tp_line)
        line.set_x2(active_tp_line, bar_index)
        active_tp_line := na
    if not na(active_sl_line)
        line.set_x2(active_sl_line, bar_index)
        active_sl_line := na

    pos               := 0
    last_exit_bar_idx := bar_index
    bull_state        := 0
    bear_state        := 0
    bull_wave_traded := false
    bear_wave_traded := false
    active_bias      := "NONE"

// ==============================================================================
// 5. 09:30 AM EST NYSE OPENING BELL RESET
// ==============================================================================
if is_rth_open
    day_high            := high
    day_low             := low

    // Strict Wave 1 Initialization: Wave 1 is strictly for setup qualification (untraded).
    // Both sides begin in State 1 tracking the opening expansion anchor and extreme.
    // Wave 2 begins ONLY after Wave 1 retraces to 50% (State 2) and breaks out past extreme (State 3).
    bull_state          := 1
    bull_anchor         := day_low
    bull_extreme        := day_low
    bull_anchor_bar     := bar_index
    bull_extreme_bar    := bar_index
    bull_lowest_w1_bar  := bar_index

    bear_state          := 1
    bear_anchor         := day_high
    bear_extreme        := day_high
    bear_anchor_bar     := bar_index
    bear_extreme_bar    := bar_index
    bear_highest_w1_bar := bar_index

    active_bias         := "NONE"
    bull_wave_count     := 1
    bear_wave_count     := 1

    bull_lowest_w1      := day_low
    bull_retrace_low    := day_low
    bull_stoprun_low    := day_low
    bull_wave_traded    := false

    bear_highest_w1     := day_high
    bear_retrace_high   := day_high
    bear_stoprun_high   := day_high
    bear_wave_traded    := false

    pos                 := 0
    lowest_in_trade     := 0.0
    highest_in_trade    := 0.0

    // Reset daily HUD stats
    today_trades        := 0
    today_wins          := 0
    today_losses        := 0
    today_pts           := 0.0

// ==============================================================================
// 6. IN-TRADE MANAGEMENT & EXIT LOGIC (FORWARD-BAR EVALUATION)
// ==============================================================================
if pos == 1 and not is_session_close and not is_rth_open
    lowest_in_trade := math.min(lowest_in_trade, low)

    // Check Take Profit
    if high >= tp_price
        float pts_made = tp_price - entry_price
        today_trades += 1
        today_wins   += 1
        today_pts    += pts_made

        if show_exits
            string txt = "✔ TP Hit\n+" + str.tostring(pts_made, "#.##") + " pts"
            label.new(bar_index, tp_price, text=txt, color=col_tp, textcolor=color.black, style=label.style_label_down, size=size.small)

        if not na(active_tp_line)
            line.set_x2(active_tp_line, bar_index)
            active_tp_line := na
        if not na(active_sl_line)
            line.set_x2(active_sl_line, bar_index)
            active_sl_line := na

        bull_anchor  := lowest_in_trade
        bull_anchor_bar := bar_index
        bull_extreme := tp_price
        bull_extreme_bar := bar_index
        active_bias  := "BULL"
        bull_state   := 3
        bull_wave_count += 1
        pos          := 0
        last_exit_bar_idx := bar_index

    // Check Stop Loss
    else if low <= sl_price
        float pts_made = sl_price - entry_price
        today_trades += 1
        today_losses += 1
        today_pts    += pts_made

        if show_exits
            string txt = "✖ SL Hit\n" + str.tostring(pts_made, "#.##") + " pts"
            label.new(bar_index, sl_price, text=txt, color=col_sl, textcolor=color.white, style=label.style_label_up, size=size.small)

        if not na(active_tp_line)
            line.set_x2(active_tp_line, bar_index)
            active_tp_line := na
        if not na(active_sl_line)
            line.set_x2(active_sl_line, bar_index)
            active_sl_line := na

        if low >= day_low
            bull_state := 5
            bull_stoprun_low := low
        else
            bull_state := 0

        // SEAMLESS OPPOSING WAVE TRANSITION
        active_bias := (bear_state >= 3) ? "BEAR" : "NONE"
        pos         := 0
        last_exit_bar_idx := bar_index

else if pos == -1 and not is_session_close and not is_rth_open
    highest_in_trade := math.max(highest_in_trade, high)

    // Check Take Profit
    if low <= tp_price
        float pts_made = entry_price - tp_price
        today_trades += 1
        today_wins   += 1
        today_pts    += pts_made

        if show_exits
            string txt = "✔ TP Hit\n+" + str.tostring(pts_made, "#.##") + " pts"
            label.new(bar_index, tp_price, text=txt, color=col_tp, textcolor=color.black, style=label.style_label_up, size=size.small)

        if not na(active_tp_line)
            line.set_x2(active_tp_line, bar_index)
            active_tp_line := na
        if not na(active_sl_line)
            line.set_x2(active_sl_line, bar_index)
            active_sl_line := na

        bear_anchor  := highest_in_trade
        bear_anchor_bar := bar_index
        bear_extreme := tp_price
        bear_extreme_bar := bar_index
        active_bias  := "BEAR"
        bear_state   := 3
        bear_wave_count += 1
        pos          := 0
        last_exit_bar_idx := bar_index

    // Check Stop Loss
    else if high >= sl_price
        float pts_made = entry_price - sl_price
        today_trades += 1
        today_losses += 1
        today_pts    += pts_made

        if show_exits
            string txt = "✖ SL Hit\n" + str.tostring(pts_made, "#.##") + " pts"
            label.new(bar_index, sl_price, text=txt, color=col_sl, textcolor=color.white, style=label.style_label_down, size=size.small)

        if not na(active_tp_line)
            line.set_x2(active_tp_line, bar_index)
            active_tp_line := na
        if not na(active_sl_line)
            line.set_x2(active_sl_line, bar_index)
            active_sl_line := na

        if high <= day_high
            bear_state := 5
            bear_stoprun_high := high
        else
            bear_state := 0

        // SEAMLESS OPPOSING WAVE TRANSITION
        active_bias := (bull_state >= 3) ? "BULL" : "NONE"
        pos         := 0
        last_exit_bar_idx := bar_index

// ==============================================================================
// 7. SESSION HIGH / LOW TRACKING
// ==============================================================================
if low < day_low
    day_low          := low
    bull_state       := 1
    bull_anchor      := day_low
    bull_extreme     := day_low
    bull_anchor_bar  := bar_index
    bull_extreme_bar := bar_index
    bull_lowest_w1_bar := bar_index
    bull_wave_traded := false
    bull_wave_count  := 1
    if active_bias == "BULL"
        active_bias := "NONE"

if high > day_high
    day_high         := high
    bear_state       := 1
    bear_anchor      := day_high
    bear_extreme     := day_high
    bear_anchor_bar  := bar_index
    bear_extreme_bar := bar_index
    bear_highest_w1_bar := bar_index
    bear_wave_traded := false
    bear_wave_count  := 1
    if active_bias == "BEAR"
        active_bias := "NONE"

// ==============================================================================
// 8. 5-STATE EXPANSION ENGINE & 50% EQUILIBRIUM ENTRIES (1 TRADE PER WAVE)
// ==============================================================================
if is_window and not is_rth_open
    // --- BULLISH STATE MACHINE ---
    if bull_state == 1
        if high > bull_extreme
            bull_extreme := high
            bull_extreme_bar := bar_index
        float bull_50 = bull_extreme - 0.50 * (bull_extreme - bull_anchor)
        if (bull_extreme - bull_anchor) > syminfo.mintick and low <= bull_50
            bull_state := 2
            bull_lowest_w1 := low
            bull_lowest_w1_bar := bar_index

    else if bull_state == 2
        if low < bull_lowest_w1
            bull_lowest_w1 := low
            bull_lowest_w1_bar := bar_index
        if low < bull_anchor
            bull_state := 0
            if active_bias == "BULL"
                active_bias := "NONE"
        else if high >= bull_extreme
            bull_state       := 3
            bull_anchor      := bull_lowest_w1
            bull_anchor_bar  := bull_lowest_w1_bar
            bull_extreme     := high
            bull_extreme_bar := bar_index
            active_bias      := "BULL"
            bull_wave_traded := false
            bull_wave_count  := 2

    else if bull_state == 3
        if low < bull_anchor
            bull_state := (low >= day_low) ? 5 : 0
            if bull_state == 5
                bull_stoprun_low := low
            if active_bias == "BULL"
                active_bias := "NONE"
        else
            if high > bull_extreme
                bull_extreme     := high
                bull_extreme_bar := bar_index
                bull_wave_traded := false
            float bull_50 = bull_extreme - 0.50 * (bull_extreme - bull_anchor)
            // Canonical Minimum 2-Candle Impulse Rule: (bull_extreme_bar > bull_anchor_bar)
            if (bull_extreme - bull_anchor) > syminfo.mintick and low <= bull_50 and (bull_extreme_bar > bull_anchor_bar)
                bull_state := 4
                bull_retrace_low := low
                float trade_range = bull_extreme - bull_anchor

                // Canonical 1-Trade-Per-Wave & No-Chain Gate: Range >= 8.0 pts & Bias == BULL & bar_index > last_exit_bar_idx & !bull_wave_traded
                if pos == 0 and bar_index > last_exit_bar_idx and not bull_wave_traded and active_bias == "BULL" and trade_range >= min_range
                    pos              := 1
                    bull_wave_traded := true
                    entry_price      := bull_50
                    float buffer     = close * 0.00005
                    sl_price         := bull_anchor - buffer
                    tp_price         := bull_extreme
                    lowest_in_trade  := low
                    entry_bar_idx    := bar_index
                    current_trade_wave := bull_wave_count

                    if show_arrow
                        string txt = "▲ LONG (W" + str.tostring(current_trade_wave) + ")\n" + str.tostring(entry_price, "#.##")
                        label.new(bar_index, low, text=txt, color=col_bull, textcolor=color.black, style=label.style_label_up, yloc=yloc.belowbar, size=size.small)

                    if show_lines
                        active_tp_line := line.new(bar_index, tp_price, bar_index + 1, tp_price, color=col_tp, width=1, style=line.style_dashed)
                        active_sl_line := line.new(bar_index, sl_price, bar_index + 1, sl_price, color=col_sl, width=1, style=line.style_dashed)

                    alert("50% Equilibrium LONG Triggered @ " + str.tostring(entry_price), alert.freq_once_per_bar)

    else if bull_state == 4
        bull_retrace_low := math.min(bull_retrace_low, low)
        if low < bull_anchor
            bull_state := (low >= day_low) ? 5 : 0
            if bull_state == 5
                bull_stoprun_low := low
            if active_bias == "BULL"
                active_bias := "NONE"
        else if high >= bull_extreme
            bull_state       := 3
            bull_anchor      := bull_retrace_low
            bull_anchor_bar  := bar_index
            bull_extreme     := high
            bull_extreme_bar := bar_index
            active_bias      := "BULL"
            bull_wave_traded := false
            bull_wave_count  += 1

    else if bull_state == 5
        bull_stoprun_low := math.min(bull_stoprun_low, low)
        if high >= bull_extreme
            bull_state       := 3
            bull_anchor      := bull_stoprun_low
            bull_anchor_bar  := bar_index
            bull_extreme     := high
            bull_extreme_bar := bar_index
            active_bias      := "BULL"
            bull_wave_traded := false
            bull_wave_count  += 1

    // --- BEARISH STATE MACHINE ---
    if bear_state == 1
        if low < bear_extreme
            bear_extreme := low
            bear_extreme_bar := bar_index
        float bear_50 = bear_extreme + 0.50 * (bear_anchor - bear_extreme)
        if (bear_anchor - bear_extreme) > syminfo.mintick and high >= bear_50
            bear_state := 2
            bear_highest_w1 := high
            bear_highest_w1_bar := bar_index

    else if bear_state == 2
        if high > bear_highest_w1
            bear_highest_w1 := high
            bear_highest_w1_bar := bar_index
        if high > bear_anchor
            bear_state := 0
            if active_bias == "BEAR"
                active_bias := "NONE"
        else if low <= bear_extreme
            bear_state       := 3
            bear_anchor      := bear_highest_w1
            bear_anchor_bar  := bear_highest_w1_bar
            bear_extreme     := low
            bear_extreme_bar := bar_index
            active_bias      := "BEAR"
            bear_wave_traded := false
            bear_wave_count  := 2

    else if bear_state == 3
        if high > bear_anchor
            bear_state := (high <= day_high) ? 5 : 0
            if bear_state == 5
                bear_stoprun_high := high
            if active_bias == "BEAR"
                active_bias := "NONE"
        else
            if low < bear_extreme
                bear_extreme     := low
                bear_extreme_bar := bar_index
                bear_wave_traded := false
            float bear_50 = bear_extreme + 0.50 * (bear_anchor - bear_extreme)
            // Canonical Minimum 2-Candle Impulse Rule: (bear_extreme_bar > bear_anchor_bar)
            if (bear_anchor - bear_extreme) > syminfo.mintick and high >= bear_50 and (bear_extreme_bar > bear_anchor_bar)
                bear_state := 4
                bear_retrace_high := high
                float trade_range = bear_anchor - bear_extreme

                // Canonical 1-Trade-Per-Wave & No-Chain Gate: Range >= 8.0 pts & Bias == BEAR & bar_index > last_exit_bar_idx & !bear_wave_traded
                if pos == 0 and bar_index > last_exit_bar_idx and not bear_wave_traded and active_bias == "BEAR" and trade_range >= min_range
                    pos              := -1
                    bear_wave_traded := true
                    entry_price      := bear_50
                    float buffer     = close * 0.00005
                    sl_price         := bear_anchor + buffer
                    tp_price         := bear_extreme
                    highest_in_trade := high
                    entry_bar_idx    := bar_index
                    current_trade_wave := bear_wave_count

                    if show_arrow
                        string txt = "▼ SHORT (W" + str.tostring(current_trade_wave) + ")\n" + str.tostring(entry_price, "#.##")
                        label.new(bar_index, high, text=txt, color=col_bear, textcolor=color.white, style=label.style_label_down, yloc=yloc.abovebar, size=size.small)

                    if show_lines
                        active_tp_line := line.new(bar_index, tp_price, bar_index + 1, tp_price, color=col_tp, width=1, style=line.style_dashed)
                        active_sl_line := line.new(bar_index, sl_price, bar_index + 1, sl_price, color=col_sl, width=1, style=line.style_dashed)

                    alert("50% Equilibrium SHORT Triggered @ " + str.tostring(entry_price), alert.freq_once_per_bar)

    else if bear_state == 4
        bear_retrace_high := math.max(bear_retrace_high, high)
        if high > bear_anchor
            bear_state := (high <= day_high) ? 5 : 0
            if bear_state == 5
                bear_stoprun_high := high
            if active_bias == "BEAR"
                active_bias := "NONE"
        else if low <= bear_extreme
            bear_state       := 3
            bear_anchor      := bear_retrace_high
            bear_anchor_bar  := bar_index
            bear_extreme     := low
            bear_extreme_bar := bar_index
            active_bias      := "BEAR"
            bear_wave_traded := false
            bear_wave_count  += 1

    else if bear_state == 5
        bear_stoprun_high := math.max(bear_stoprun_high, high)
        if low <= bear_extreme
            bear_state       := 3
            bear_anchor      := bear_stoprun_high
            bear_anchor_bar  := bar_index
            bear_extreme     := low
            bear_extreme_bar := bar_index
            active_bias      := "BEAR"
            bear_wave_traded := false
            bear_wave_count  += 1

// Extend active lines to current bar while in trade
if pos != 0 and show_lines
    if not na(active_tp_line)
        line.set_x2(active_tp_line, bar_index)
    if not na(active_sl_line)
        line.set_x2(active_sl_line, bar_index)

// ==============================================================================
// 9. MODERN HUD STATUS DASHBOARD (TOP RIGHT)
// ==============================================================================
var table hud = table.new(position.top_right, 2, 5, bgcolor=color.new(#1E222D, 15), border_color=color.new(#363A45, 50), border_width=1)

if show_hud and barstate.islast
    // Header
    table.cell(hud, 0, 0, "50% Equilibrium Engine", bgcolor=color.new(#2962FF, 20), text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(hud, 1, 0, "Morning Sniper v6", bgcolor=color.new(#2962FF, 20), text_color=#00E676, text_size=size.small, text_halign=text.align_right)

    // Session Status
    string session_str = is_window ? ("ACTIVE (" + (session_mode == "Morning Sniper (09:30 - 11:30)" ? "09:30-11:30" : "09:30-16:00") + ")") : "CLOSED"
    color  session_col = is_window ? col_bull : col_flat
    table.cell(hud, 0, 1, "Session Window", text_color=#B2B5BE, text_size=size.small, text_halign=text.align_left)
    table.cell(hud, 1, 1, session_str, text_color=session_col, text_size=size.small, text_halign=text.align_right)

    // Market Bias
    string bias_str = active_bias == "BULL" ? "BULLISH (Wave " + str.tostring(bull_state) + ")" : active_bias == "BEAR" ? "BEARISH (Wave " + str.tostring(bear_state) + ")" : "NEUTRAL"
    color  bias_col = active_bias == "BULL" ? col_bull : active_bias == "BEAR" ? col_bear : col_flat
    table.cell(hud, 0, 2, "Structural Bias", text_color=#B2B5BE, text_size=size.small, text_halign=text.align_left)
    table.cell(hud, 1, 2, bias_str, text_color=bias_col, text_size=size.small, text_halign=text.align_right)

    // Current Position
    string pos_str = pos == 1 ? "LONG @ " + str.tostring(entry_price, "#.##") : pos == -1 ? "SHORT @ " + str.tostring(entry_price, "#.##") : "FLAT"
    color  pos_col = pos == 1 ? col_bull : pos == -1 ? col_bear : color.white
    table.cell(hud, 0, 3, "Active Position", text_color=#B2B5BE, text_size=size.small, text_halign=text.align_left)
    table.cell(hud, 1, 3, pos_str, text_color=pos_col, text_size=size.small, text_halign=text.align_right)

    // Today's Performance
    string perf_str = str.tostring(today_trades) + " Trades (" + str.tostring(today_wins) + "W / " + str.tostring(today_losses) + "L) | " + (today_pts >= 0 ? "+" : "") + str.tostring(today_pts, "#.##") + " pts"
    color  perf_col = today_pts >= 0 ? col_bull : col_bear
    table.cell(hud, 0, 4, "Today's Session", text_color=#B2B5BE, text_size=size.small, text_halign=text.align_left)
    table.cell(hud, 1, 4, perf_str, text_color=perf_col, text_size=size.small, text_halign=text.align_right)
